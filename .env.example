APP_ENV=production
APP_URL=https://literaryhonor.com

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=literary_honors
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_password

# Update this before going live. Todd's notification email is never stored in Git.
TODD_NOTIFICATION_EMAIL=replace_with_todd_email@example.com
MAIL_FROM_EMAIL=no-reply@literaryhonor.com
MAIL_FROM_NAME="Literary Honors Book Awards"
# Use `log` while testing. Change to `resend` only after adding a live key.
MAIL_PROVIDER=log
RESEND_API_KEY=re_replace_with_your_api_key

# Create a long random value and use it only while setting up the first admin.
ADMIN_SETUP_KEY=replace_with_a_long_random_setup_key

# Stripe test mode values begin with sk_test_ and whsec_. Never commit real keys.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_test_webhook_secret
